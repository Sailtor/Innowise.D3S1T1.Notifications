{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "Host": "*",
    "VirtualHost": "/",
    "Username": "*",
    "Password": "*"
  },
  "Thresholds": {
    "Co2Threshold": 1000,
    "Pm25Threshold": 35,
    "MotionAlertEnabled": true
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}
